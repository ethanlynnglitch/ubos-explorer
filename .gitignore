# --- Python -----------------------------------------------------------------
__pycache__/
*.py[cod]
*$py.class
.venv/
venv/
env/
*.egg-info/
.pytest_cache/
.ipynb_checkpoints/

# --- Derived data artifacts -------------------------------------------------
# Everything below is rebuildable from data/raw/ with:
#   python -m ubos_explorer.pipeline   (writes data/processed/)
#   python -m ubos_explorer.warehouse  (writes data/ubos.duckdb)
data/processed/
data/ubos.duckdb
data/ubos.duckdb.wal
data/warehouse/

# Collector downloads. Transient staging: a workbook is only kept permanently
# once a human promotes it into data/raw/.
data/incoming/

# --- Streamlit --------------------------------------------------------------
.streamlit/secrets.toml

# --- Credentials: never commit these ----------------------------------------
# SSH keys must live in ~/.ssh, never in a repository.
id_rsa
id_ed25519
id_ecdsa
*.pem
*.ppk
# Exception: this is a PUBLIC CA intermediate certificate, not a secret. It is
# needed because www.ubos.org fails to send its intermediate cert, and we refuse
# to work around that by disabling TLS verification.
!src/ubos_explorer/certs/*.pem
authoris*_keys*
authoriz*_keys*
.env
.env.*
*.secret

# --- OS / editors -----------------------------------------------------------
.DS_Store
Thumbs.db
.idea/
.vscode/
*.swp
